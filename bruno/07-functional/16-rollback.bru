      {
        "produtoId": "{{functionalProduct2}}",
        "quantidade": 1
      }
    ],
    "entrega": {
      "tipo": "levantamento"
    }
  }
}

tests {
  test("Stock insuficiente aborta encomenda", function() {
    expect(res.getStatus()).to.equal(409);
  });
}
