meta {
  name: Rejeita avaliação antes de entrega
  type: http
  seq: 26
}

post {
  url: {{baseUrl}}/reviews
  body: json
  auth: bearer
}

auth:bearer {
  token: {{testBuyerToken}}
}

body:json {
  {
    "encomendaId": "{{functionalOrder}}",
    "produtoId": "{{functionalProduct1}}",
    "classificacao": 4,
    "comentario": "{{testRun}} prematura"
  }
}

tests {
  test("Rejeita avaliação antes de entrega", function() {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().erro).to.equal("Só podes avaliar encomendas entregues que te pertencem.");
  });
}
