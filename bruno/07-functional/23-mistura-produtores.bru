meta {
  name: Cria encomendas de vários produtores
  type: http
  seq: 23
}

post {
  url: {{baseUrl}}/orders
  body: json
  auth: bearer
}

auth:bearer {
  token: {{testBuyerToken}}
}

body:json {
  {
    "linhas": [
      {
        "produtoId": "{{functionalProduct1}}",
        "quantidade": 1
      },
      {
        "produtoId": "dca0000000000000000007db",
        "quantidade": 1
      }
    ],
    "entrega": {
      "tipo": "levantamento"
    }
  }
}

tests {
  test("Cria encomendas de vários produtores", function() {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody()).to.have.length(2);
    expect(new Set(res.getBody().map(order => order.produtorId)).size).to.equal(2);
  });
}
