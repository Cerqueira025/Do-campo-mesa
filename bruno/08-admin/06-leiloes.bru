meta {
  name: Consulta administrativa leiloes
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/admin/auctions?estado=ativo
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

tests {
  test("consulta administrativa paginada sem hashes", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().items).to.be.an("array");
    expect(res.getBody().limit).to.equal(24);
    expect(res.getBody().total).to.be.a("number");
    expect(JSON.stringify(res.getBody())).not.to.include("passwordHash");
  });
}
