meta {
  name: Cria encomenda de teste
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/orders
  body: json
  auth: bearer
}

auth:bearer {
  token: {{testBuyerToken}}
}

body:json {
  {
    "linhas": [
      { "produtoId": "dca000000000000000000065", "quantidade": 1 }
    ],
    "entrega": { "tipo": "levantamento" }
  }
}

tests {
  test("cria encomenda com preço calculado pelo servidor", function() {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody()).to.have.length(1);
    const order = res.getBody()[0];
    expect(order.estado).to.equal("pendente");
    expect(order.total).to.equal(order.linhas[0].precoUnitario);
    expect(order.compradorId).to.equal(bru.getVar("testBuyerId"));
  });
}

script:post-response {
  bru.setVar("testOrderId", res.getBody()[0]._id);
}
