meta {
  name: Entrega encomenda temporária para avaliação
  type: http
  seq: 8
}

patch {
  url: {{baseUrl}}/orders/{{testOrderId}}/estado
  body: json
  auth: bearer
}

auth:bearer {
  token: {{producerToken}}
}

body:json {
  { "estado": "entregue" }
}

tests {
  test("produtor entrega a encomenda temporária", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().estado).to.equal("entregue");
  });
}
