meta {
  name: Republica avaliação para testar denúncias
  type: http
  seq: 9
}

patch {
  url: {{baseUrl}}/reviews/{{testReviewId}}/moderacao
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {"estado": "publicada", "decisaoAnterior": "{{reviewDecision}}", "atualizadoEm": "{{reviewUpdatedAt}}"}
}

tests {
  test("devolve 200", function() { expect(res.getStatus()).to.equal(200); });
}
