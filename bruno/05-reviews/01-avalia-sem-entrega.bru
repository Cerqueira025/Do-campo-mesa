meta {
  name: Impede avaliação de encomenda por entregar
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/reviews
  body: json
  auth: bearer
}

auth:bearer {
  token: {{restaurantToken}}
}

body:json {
  {
    "encomendaId": "dca0000000000000000000ca",
    "produtoId": "dca000000000000000000066",
    "classificacao": 5,
    "comentario": "{{testRun}} avaliação inválida"
  }
}

tests {
  test("encomenda pendente não pode ser avaliada", function() {
    expect(res.getStatus()).to.equal(400);
  });
}
