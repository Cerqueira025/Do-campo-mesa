meta {
  name: Admin oculta avaliação
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/reviews/{{testReviewId}}/moderacao
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  { "estado": "oculta", "motivo": "Conteúdo inadequado no cenário de teste", "decisaoAnterior": null }
}

tests {
  test("admin oculta a avaliação", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().estado).to.equal("oculta");
  });
}
