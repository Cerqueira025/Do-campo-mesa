meta {
  name: Cria avaliação de encomenda entregue
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/reviews
  body: json
  auth: bearer
}

auth:bearer {
  token: {{testBuyerToken}}
}

body:json {
  {
    "encomendaId": "{{testOrderId}}",
    "produtoId": "dca000000000000000000065",
    "classificacao": 5,
    "comentario": "{{testRun}} avaliação automática"
  }
}

tests {
  test("cria avaliação ligada a encomenda entregue", function() {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().estado).to.equal("publicada");
    expect(res.getBody().classificacao).to.equal(5);
    expect(res.getBody().comentario).to.contain("BRUNO_AUTOTEST_");
  });
}

script:post-response {
  bru.setVar("testReviewId", res.getBody()._id);
}
