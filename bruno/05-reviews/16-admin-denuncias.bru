meta {
  name: Admin consulta denúncia e referência atual
  type: http
  seq: 16
}

get {
  url: {{baseUrl}}/admin/reviews/{{testReviewId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

tests {
  test("devolve 200", function() { expect(res.getStatus()).to.equal(200); });
  test("inclui motivos apenas na administração", function() {
    expect(res.getBody().totalDenuncias).to.equal(1);
    expect(res.getBody().denuncias[0].motivo).to.equal("Conteúdo inadequado no cenário Bruno");
  });
}

script:post-response {
  bru.setVar("reviewDecision", res.getBody().ultimaDecisao?.data ?? null);
  bru.setVar("reviewUpdatedAt", res.getBody().updatedAt);
}
