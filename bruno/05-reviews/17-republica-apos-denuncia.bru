meta {
  name: Republica preservando denúncia
  type: http
  seq: 17
}

patch {
  url: {{baseUrl}}/reviews/{{testReviewId}}/moderacao
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {"estado": "publicada", "decisaoAnterior": "{{reviewDecision}}", "atualizadoEm": "{{reviewUpdatedAt}}"}
}

tests {
  test("republica a avaliação sem expor denúncias no resultado da moderação", function() {
    expect(res.getStatus()).to.equal(200);
    const review = res.getBody();
    expect(review.estado).to.equal("publicada");
    expect(review).not.to.have.property("denuncias");
  });
}
