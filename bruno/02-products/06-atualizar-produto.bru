meta {
  name: Atualiza produto de teste
  type: http
  seq: 6
}

put {
  url: {{baseUrl}}/products/{{testProductId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{producerToken}}
}

body:json {
  { "preco": 150, "stock": 4 }
}

tests {
  test("atualiza os campos do produto", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().preco).to.equal(150);
    expect(res.getBody().stock).to.equal(4);
  });
}
