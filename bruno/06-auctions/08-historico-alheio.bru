meta {
  name: Outro produtor não consulta o histórico privado
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/auctions/mine/{{testAuctionId}}/bids
  body: none
  auth: bearer
}

auth:bearer {
  token: {{otherProducerToken}}
}

tests {
  test("Outro produtor não consulta o histórico privado", function() {
    expect(res.getStatus()).to.equal(404);
    expect(res.getBody().erro).to.equal("Leilão não encontrado.");
  });
}
