meta {
  name: Cria leilão agendado de teste
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/auctions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{producerToken}}
}

body:json {
  {
    "produtos": [{ "produtoId": "dca000000000000000000065", "quantidade": 2 }],
    "lote": "{{testRun}} lote de teste",
    "precoBase": 500,
    "incremento": 50,
    "dataInicio": "2099-01-01T10:00:00.000Z",
    "dataFim": "2100-01-01T10:00:00.000Z"
  }
}

tests {
  test("cria leilão agendado com licitação base", function() {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().estado).to.equal("agendado");
    expect(res.getBody().reservaStock).to.equal("pendente");
    expect(res.getBody().licitacaoAtual.valor).to.equal(500);
    expect(res.getBody().licitacaoAtual.compradorId).to.equal(null);
  });
}

script:post-response {
  bru.setVar("testAuctionId", res.getBody()._id);
}
