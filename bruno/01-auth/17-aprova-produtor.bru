meta {
  name: Administrador aprova produtor de teste
  type: http
  seq: 17
}

patch {
  url: {{baseUrl}}/producers/{{authProducerId}}/validacao
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{adminToken}}
}

body:json {
  { "validacao": "aceite" }
}

tests {
  test("aprovação devolve estado atualizado", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().validacao).to.equal("aceite");
    expect(res.getBody()).to.not.have.property("passwordHash");
  });
}
