meta {
  name: Rejeita credenciais incorretas
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{buyerEmail}}",
    "password": "password-incorreta"
  }
}

tests {
  test("credenciais incorretas devolvem 401", function() {
    expect(res.getStatus()).to.equal(401);
    expect(res.getBody()).to.have.property("erro");
  });
}
