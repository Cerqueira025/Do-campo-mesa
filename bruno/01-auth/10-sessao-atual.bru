meta {
  name: Consulta sessão atual
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/auth/eu
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{testBuyerToken}}
}

tests {
  test("sessão confirma identidade sem expor hashes", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().id).to.equal(bru.getVar("testBuyerId"));
    expect(res.getBody()).to.not.have.property("passwordHash");
    expect(res.getBody()).to.not.have.property("password");
  });
}
