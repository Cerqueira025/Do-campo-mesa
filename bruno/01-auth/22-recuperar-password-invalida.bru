meta {
  name: Recuperação rejeita password curta
  type: http
  seq: 22
}

post {
  url: {{baseUrl}}/auth/recuperar-password
  body: json
  auth: none
}

body:json {
  { "email": "{{testEmail}}", "password": "curta" }
}

tests {
  test("password inválida devolve 400", function() {
    expect(res.getStatus()).to.equal(400);
  });
}
