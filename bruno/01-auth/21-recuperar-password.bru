meta {
  name: Substitui password do comprador fictício
  type: http
  seq: 21
}

post {
  url: {{baseUrl}}/auth/recuperar-password
  body: json
  auth: none
}

body:json {
  { "email": "{{testEmail}}", "password": "BrunoNovaPassword123!", "papel": "administrador" }
}

tests {
  test("recuperação de demonstração devolve apenas confirmação", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.deep.equal({ mensagem: "Palavra-passe atualizada." });
  });
}
