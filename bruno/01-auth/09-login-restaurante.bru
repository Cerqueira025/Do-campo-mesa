meta {
  name: Login comprador Restaurante Demo
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{restaurantEmail}}",
    "password": "{{demoPassword}}"
  }
}

tests {
  test("login identifica segundo comprador", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().utilizador.papel).to.equal("comprador");
  });
}

script:post-response {
  bru.setVar("restaurantToken", res.getBody().token);
}
