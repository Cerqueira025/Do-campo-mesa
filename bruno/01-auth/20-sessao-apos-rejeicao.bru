meta {
  name: Sessão preserva aprovação após conflito
  type: http
  seq: 20
}

get {
  url: {{baseUrl}}/auth/eu
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{authProducerToken}}
}

tests {
  test("mesmo token mantém a aprovação", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().validacao).to.equal("aceite");
  });
}
