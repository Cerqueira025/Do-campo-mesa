meta {
  name: Nova password permite login sem mudar o papel
  type: http
  seq: 24
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  { "email": "{{testEmail}}", "password": "BrunoNovaPassword123!" }
}

tests {
  test("login com nova password mantém os dados da conta", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().utilizador.id).to.equal(bru.getVar("testBuyerId"));
    expect(res.getBody().utilizador.papel).to.equal("comprador");
    expect(res.getBody().utilizador).to.not.have.property("passwordHash");
  });
}
